# ML Microservice Environment Configuration

# Service Network Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Service Security & Authentication
# Requests must supply matching header: X-API-Key: <ML_API_KEY>
ML_API_KEY=replace_with_internal_secret_key_matching_server

# Model Artifact Paths
MODEL_PATH=models/threat_classifier.joblib
LABEL_ENCODER_PATH=models/label_encoder.joblib
SCALER_PATH=models/scaler.joblib
