{
  "openapi": "3.0.3",
  "info": {
    "title": "AI CyberShield REST API",
    "version": "1.0.0",
    "description": "Educational Cyberattack Detection and Threat Analysis System REST API. Developed at Dev Bhoomi Uttarakhand University.",
    "contact": {
      "name": "AI CyberShield Security Team"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    },
    {
      "url": "https://ai-cybershield-server.onrender.com",
      "description": "Production Render Web Service"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256 signed JSON Web Token issued by /api/auth/login"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "error" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string", "example": "Invalid request parameters" },
              "details": { "type": "object" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["status", "error"]
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65f01a2b3c4d5e6f7a8b9c0d" },
          "name": { "type": "string", "example": "Security Analyst" },
          "email": { "type": "string", "format": "email", "example": "analyst@cybershield.org" },
          "role": { "type": "string", "enum": ["admin", "analyst", "viewer"], "example": "analyst" },
          "isActive": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ThreatExplanationFactor": {
        "type": "object",
        "properties": {
          "factor": { "type": "string", "example": "attack_class_severity" },
          "contribution": { "type": "number", "example": 51 },
          "description": { "type": "string", "example": "Severity contribution for DoS/DDoS class (weight 0.6)" }
        }
      },
      "DetectionResult": {
        "type": "object",
        "properties": {
          "mlClass": { "type": "string", "enum": ["Benign", "BruteForce", "DoS/DDoS", "PortScan"], "example": "DoS/DDoS" },
          "confidence": { "type": "number", "format": "float", "example": 0.98 },
          "probabilities": {
            "type": "object",
            "additionalProperties": { "type": "number" },
            "example": { "Benign": 0.01, "BruteForce": 0.01, "DoS/DDoS": 0.98, "PortScan": 0.00 }
          },
          "baselineClass": { "type": "string", "enum": ["Benign", "BruteForce", "DoS/DDoS", "PortScan"], "example": "DoS/DDoS" },
          "baselineRule": { "type": "string", "example": "High packet flood heuristic" },
          "threatScore": { "type": "integer", "minimum": 0, "maximum": 100, "example": 92 },
          "riskLevel": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"], "example": "Critical" },
          "explanation": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ThreatExplanationFactor" }
          }
        }
      },
      "Incident": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "flowId": { "type": "string" },
          "mlClass": { "type": "string" },
          "confidence": { "type": "number" },
          "baselineClass": { "type": "string" },
          "score": { "type": "integer" },
          "riskLevel": { "type": "string" },
          "status": { "type": "string", "enum": ["New", "Under Review", "Resolved", "False Positive"] },
          "flowSummary": {
            "type": "object",
            "properties": {
              "srcIp": { "type": "string" },
              "dstIp": { "type": "string" },
              "srcPort": { "type": "integer" },
              "dstPort": { "type": "integer" },
              "protocol": { "type": "string" }
            }
          },
          "detectedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check and database connectivity probe",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "healthy" },
                    "uptime": { "type": "number", "example": 120 },
                    "database": { "type": "string", "example": "connected" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user account (defaults to Viewer role)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Jane Doe" },
                  "email": { "type": "string", "format": "email", "example": "jane@example.com" },
                  "password": { "type": "string", "format": "password", "example": "SecurePassword123!" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" },
          "400": { "$ref": "#/components/schemas/ErrorResponse" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "admin@cybershield.org" },
                  "password": { "type": "string", "format": "password", "example": "AdminPassword123!" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated successfully" },
          "401": { "$ref": "#/components/schemas/ErrorResponse" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile" },
          "401": { "$ref": "#/components/schemas/ErrorResponse" }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "summary": "Query paginated incident catalog",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "riskLevel", "in": "query", "schema": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["New", "Under Review", "Resolved", "False Positive"] } },
          { "name": "mlClass", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paginated incidents list" }
        }
      }
    },
    "/api/incidents/{id}": {
      "get": {
        "summary": "Get incident details by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Incident details" },
          "400": { "$ref": "#/components/schemas/ErrorResponse" },
          "404": { "$ref": "#/components/schemas/ErrorResponse" }
        }
      }
    },
    "/api/incidents/{id}/status": {
      "patch": {
        "summary": "Update incident triage status (Analyst & Admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["Under Review", "Resolved", "False Positive"] }
                },
                "required": ["status"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Status updated successfully" },
          "403": { "$ref": "#/components/schemas/ErrorResponse" }
        }
      }
    },
    "/api/detect/flow": {
      "post": {
        "summary": "Evaluate network flow through ML and scoring engines (Analyst & Admin only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "flow": { "type": "object", "description": "67 CIC-IDS2017 flow features" },
                  "flowSummary": { "type": "object" }
                },
                "required": ["flow"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow evaluation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/DetectionResult" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/upload": {
      "post": {
        "summary": "Ingest CSV network traffic dataset (Analyst & Admin only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "name": { "type": "string" }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Dataset uploaded and processed" }
        }
      }
    },
    "/api/evaluation/dataset/{id}": {
      "get": {
        "summary": "Retrieve comparative evaluation (ML vs Rule-Based Baseline)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Comparative evaluation metrics" }
        }
      }
    },
    "/api/stats/summary": {
      "get": {
        "summary": "Get aggregate SOC KPI counters",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Telemetry KPI counts" }
        }
      }
    }
  }
}
