# Dependencies
node_modules/
.pnp/
.pnp.js

# Python / uv
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Environment variables (allow .env.example only)
.env*
!.env.example

# Large ML model artifacts and datasets (> 50MB)
*.joblib
*.pkl
*.onnx
*.h5
*.pt
*.pth
data/raw/
data/processed/
ml-training/data/

# Allow compact trained model artifacts (< 1MB) required for CI and deployment
!ml-service/artifacts/model.joblib
!ml-service/artifacts/preprocessor.joblib
!ml-training/artifacts/model.joblib
!ml-training/artifacts/preprocessor.joblib

# Allow demo flow sample under 1MB if present
!ml-training/sample/
!ml-training/sample/demo_flows.csv

# Build and runtime outputs
client/dist/
server/dist/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
