# Server Environment Configuration

# Application
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas M0 or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aicybershield?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_this_with_a_secure_random_64_char_secret_key_in_production
JWT_EXPIRES_IN=1h

# Internal Microservice Integration
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=replace_with_internal_secret_key_matching_ml_service

# Initial System Admin Seed Credentials
ADMIN_EMAIL=admin@cybershield.local
ADMIN_PASSWORD=AdminP@ssw0rdSecure!2026

# Alerts & Email Integration (Optional)
BREVO_API_KEY=
RESEND_API_KEY=
ALERT_EMAIL_TO=security-team@cybershield.local

# Logging & Monitoring
LOG_LEVEL=info
